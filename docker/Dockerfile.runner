# The runner (workbench) images: where Bash commands run (docs/ARCHITECTURE.md, "Runner").
#
# Four targets, each digest-pinned and published with a release:
#   runner-base      shell, coreutils, git, search, build-essential, and the command server
#   runner-python    runner-base + CPython 3.12 and 3.13, pip, and uv
#   runner-node      runner-base + Node LTS with npm, corepack, pnpm, and yarn
#   runner-polyglot  runner-python + Node + Go + Rust + a JDK
#
# Toolchains come from digest-pinned official images (no curl | sh). Every executable lands on
# the fixed command PATH (/usr/local/bin:/usr/bin:/bin), because commands never inherit the
# image's environment. The runner holds no secrets and mounts neither /source nor the state
# volume; the command server is standard-library Python started from a root-owned directory.

ARG PYTHON_IMAGE=python:3.12.13-slim-bookworm@sha256:ac212230555ffb7ec17c214fb4cf036ced11b30b5b460994376b0725c7f6c151
ARG PYTHON313_IMAGE=python:3.13.16-slim-bookworm@sha256:73aa5faee130c60da030e105ec971ccf57473fbd22ce73bd6fc9ba99a40b838d
ARG NODE_IMAGE=node:22.23.4-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
ARG GO_IMAGE=golang:1.24.13-bookworm@sha256:1a6d4452c65dea36aac2e2d606b01b4a029ec90cc1ae53890540ce6173ea77ac
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.9.7@sha256:ba4857bf2a068e9bc0e64eed8563b065908a4cd6bfb66b531a9c424c8e25e142
ARG RUST_IMAGE=rust:1.99.1-slim-bookworm@sha256:16113eb5d5c1e25d9359f40115225ce8719997fb0d9a3dab83e921da0308992f

FROM ${PYTHON313_IMAGE} AS python313
FROM ${UV_IMAGE} AS uv
FROM ${NODE_IMAGE} AS node
FROM ${GO_IMAGE} AS go

FROM ${RUST_IMAGE} AS rust
# Flatten the default toolchain so no rustup proxy (and no RUSTUP_HOME) is needed at run time.
RUN mkdir /toolchain && cp -a /usr/local/rustup/toolchains/*/. /toolchain/

FROM ${PYTHON_IMAGE} AS runner-base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONUTF8=1 LANG=C.UTF-8
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash coreutils git ripgrep fd-find jq make patch diffutils procps tree unzip xz-utils \
        sqlite3 universal-ctags build-essential ca-certificates \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*
# The same identity as the executor (UID 10002, group 10001), so whatever a command writes,
# whatever its mode, the executor can still hash, checkpoint, and restore it.
RUN groupadd --gid 10001 executor \
    && useradd --uid 10002 --gid 10001 --no-create-home --home-dir /tmp/executor-home executor
COPY runner /opt/euesto/runner
RUN chmod -R a-w /opt/euesto \
    && mkdir -p /work /cache /run/runner \
    && chown 10002:10001 /work /cache /run/runner \
    && chmod 2770 /work /run/runner \
    && chmod 0700 /cache
WORKDIR /opt/euesto
USER 10002:10001
STOPSIGNAL SIGTERM
ENTRYPOINT ["python3", "-E", "-s", "-m", "runner", "--sweep", "--cache-dir", "/cache"]

FROM runner-base AS runner-python
USER root
COPY --from=python313 /usr/local/bin/python3.13 /usr/local/bin/python3.13
COPY --from=python313 /usr/local/lib/python3.13 /usr/local/lib/python3.13
COPY --from=python313 /usr/local/lib/libpython3.13.so.1.0 /usr/local/lib/libpython3.13.so.1.0
COPY --from=python313 /usr/local/include/python3.13 /usr/local/include/python3.13
COPY --from=uv /uv /uvx /usr/local/bin/
RUN ldconfig \
    && python3.13 -c "import ssl, sqlite3, venv" \
    && uv --version
USER 10002:10001

FROM runner-base AS runner-node
USER root
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=node /usr/local/include/node /usr/local/include/node
COPY --from=node /opt/yarn-v1.22.22 /opt/yarn-v1.22.22
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
    && ln -s /opt/yarn-v1.22.22/bin/yarn /opt/yarn-v1.22.22/bin/yarnpkg /usr/local/bin/ \
    && npm install --global --no-fund --no-audit pnpm@10.18.3 \
    && npm cache clean --force \
    && node --version && pnpm --version && yarn --version
USER 10002:10001

FROM runner-python AS runner-polyglot
USER root
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=node /usr/local/include/node /usr/local/include/node
COPY --from=node /opt/yarn-v1.22.22 /opt/yarn-v1.22.22
COPY --from=go /usr/local/go /usr/local/go
COPY --from=rust /toolchain /usr/local/rust
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack \
    && ln -s /opt/yarn-v1.22.22/bin/yarn /opt/yarn-v1.22.22/bin/yarnpkg /usr/local/bin/ \
    && npm install --global --no-fund --no-audit pnpm@10.18.3 \
    && npm cache clean --force \
    && ln -s /usr/local/go/bin/go /usr/local/go/bin/gofmt /usr/local/bin/ \
    && for tool in /usr/local/rust/bin/*; do ln -s "$tool" /usr/local/bin/; done \
    && apt-get update \
    && apt-get install --yes --no-install-recommends default-jdk-headless \
    && rm -rf /var/lib/apt/lists/* \
    && go version && cargo --version && rustc --version && javac -version
USER 10002:10001
